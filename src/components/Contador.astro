---
import '../styles/contador.css';
---
<section class="countdown" id="countdown" role="region" aria-labelledby="countdown-title" style="position: relative; z-index: 10;">
  <div class="countdown__info">
    <div class="countdown__header">
      <h2 class="countdown__title" id="countdown-title">¡La cuenta regresiva ha comenzado!</h2>
      <div class="countdown__decoration">
        <div class="countdown__line"></div>
        <div class="countdown__star"></div>
        <div class="countdown__line"></div>
      </div>
    </div>
    <div class="countdown__timer" role="timer" aria-live="polite">
      <div class="countdown__item">
        <div class="countdown__card">
          <span class="countdown__number" id="countdown-days">00</span>
        </div>
        <span class="countdown__label">Días</span>
      </div>
      <div class="countdown__separator">:</div>
      <div class="countdown__item">
        <div class="countdown__card">
          <span class="countdown__number" id="countdown-hours">00</span>
        </div>
        <span class="countdown__label">Horas</span>
      </div>
      <div class="countdown__separator">:</div>
      <div class="countdown__item">
        <div class="countdown__card">
          <span class="countdown__number" id="countdown-minutes">00</span>
        </div>
        <span class="countdown__label">Minutos</span>
      </div>
      <div class="countdown__separator">:</div>
      <div class="countdown__item">
        <div class="countdown__card">
          <span class="countdown__number" id="countdown-seconds">00</span>
        </div>
        <span class="countdown__label">Segundos</span>
      </div>
    </div>
  </div>

  <div class="countdown__message" id="countdown-message" style="display:none;">
    <h3 class="countdown__message-title">¡Ya empezó la fiesta!</h3>
    <div class="countdown__message-emoji">🎈🎊🎉</div>
  </div>
</section>

<script>
  // Mover scrollTo fuera del DOMContentLoaded para hacerlo global
  function scrollTo(sectionId: string) {
    const section = document.getElementById(sectionId);
    if (section) section.scrollIntoView({ behavior: 'smooth' });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const EVENT_DATE = new Date('2025-05-10T13:00:00-03:00');
    const elements = {
      days: document.getElementById('countdown-days'),
      hours: document.getElementById('countdown-hours'),
      minutes: document.getElementById('countdown-minutes'),
      seconds: document.getElementById('countdown-seconds'),
    };
    const container = document.querySelector('.countdown__timer');
    const messageElement = document.getElementById('countdown-message');

    function getTimeRemaining() {
      const now = new Date();
      const diff = EVENT_DATE.getTime() - now.getTime();

      if (diff < 0) return { expired: true };
      return {
        expired: false,
        days: Math.floor(diff / (1000 * 60 * 60 * 24)),
        hours: Math.floor((diff / (1000 * 60 * 60)) % 24),
        minutes: Math.floor((diff / (1000 * 60)) % 60),
        seconds: Math.floor((diff / 1000) % 60),
      };
    }

    function updateCountdown() {
      const time = getTimeRemaining();
      if (time.expired && container && messageElement) {
        (container as HTMLElement).style.display = 'none';
        (messageElement as HTMLElement).style.display = 'block';
        return;
      }

      Object.entries(elements).forEach(([key, el]) => {
        if (el && time[key as keyof typeof time]) {
          el.textContent = String(time[key as keyof typeof time]).padStart(2, '0');
        }
      });
    }

    updateCountdown();
    const interval: number = setInterval(updateCountdown, 1000) as unknown as number;

    window.addEventListener('beforeunload', () => clearInterval(interval));
  });
</script>