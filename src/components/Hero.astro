---
import '../styles/hero.css';
---

<section class="hero" id="hero-main" aria-labelledby="hero-title">
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <div class="hero__card">
      <div class="hero__image-wrapper">
        <div class="hero__image">
          <img src="/GaliaHero.svg" alt="Galia en su primer cumpleaños" loading="lazy" class="hero__img">
          <div class="hero__image-decor" aria-hidden="true"></div>
        </div>
        <div class="hero__sparkles">
          <div class="hero__sparkle hero__sparkle--1"></div>
          <div class="hero__sparkle hero__sparkle--2"></div>
          <div class="hero__sparkle hero__sparkle--3"></div>
        </div>
      </div>

      <div class="hero__text-container">
        <h2 class="hero__subtitle">¡Acompáñame a celebrar!</h2>
        <h1 class="hero__title" id="hero-title">Mi primer añito ¡Galia!</h1>

        <div class="hero__details-wrapper">
          <button class="hero__detail-item" onclick="window.open('https://maps.google.com/?q=Club+Ciclista+Juanicó')" aria-label="Ver ubicación del evento">
            <i class="bi bi-geo-alt" aria-hidden="true"></i>
            <span class="hero__detail-text">Club Ciclista Juanicó</span>
          </button>

          <div class="hero__detail-separator" aria-hidden="true"></div>

          <button class="hero__detail-item" onclick="window.open('https://calendar.google.com/calendar/render?action=TEMPLATE&text=Cumpleaños de Galia&dates=20250510T160000Z/20250510T210000Z&details=¡Celebremos el primer añito de Galia!&location=Club Ciclista Juanicó')" aria-label="Agregar al calendario">
            <i class="bi bi-calendar-check" aria-hidden="true"></i>
            <span class="hero__detail-text">Sábado 10 de mayo de 2025</span>
          </button>

          <div class="hero__detail-separator" aria-hidden="true"></div>

          <div class="hero__detail-item" aria-label="Hora del evento">
            <i class="bi bi-clock" aria-hidden="true"></i>
            <span class="hero__detail-text">13:00 a 18:00 hs</span>
          </div>
        </div>
      </div>
    </div>

    <button class="hero__scroll-indicator" onclick="document.getElementById('countdown').scrollIntoView({behavior: 'smooth'})" aria-label="Ir a la cuenta regresiva">
      <span class="hero__scroll-text">Descubre más</span>
      <i class="bi bi-chevron-double-down" aria-hidden="true"></i>
    </button>
  </div>
</section>